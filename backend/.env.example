# 고용24 OPEN-API 인증키 (https://www.work24.go.kr → 고객센터 → OPEN-API → 서비스 소개 및 신청)
# 훈련과정: 국민내일배움카드 훈련과정(310L01)
WORK24_TRAINING_KEY=
# 채용행사(210L11)에 쓴다. 일반 채용정보(210L01)는 기업회원 전용이라 개인 키로는 오류가 난다.
WORK24_JOB_KEY=

# 공공데이터포털 인증키(선택). Q-Net API는 2026-11 현재 키 없이도 응답한다.
DATA_GO_KR_KEY=

# 응답 캐시 시간(초)
CACHE_TTL=1800

# 배포 시 실제 도메인으로 (쉼표로 여러 개). Nginx로 같은 도메인에서 서빙하면 사실상 안 쓰인다.
CORS_ORIGINS=http://localhost:5173
