# 고용24 OPEN-API 인증키 (https://www.work24.go.kr → 고객센터 → OPEN-API → 서비스 소개 및 신청)
# '채용정보'와 '국민내일배움카드 훈련과정'을 각각 신청한다.
# ※ 채용정보 API는 개인회원 키로 호출하면 "개인회원은 사용할 수 없는 OPEN-API입니다." 오류가 난다.
WORK24_JOB_KEY=
WORK24_TRAINING_KEY=

# 응답 캐시 시간(초). 일일 호출 한도 때문에 켜 둔다.
CACHE_TTL=1800

# 배포 시 실제 도메인으로 (쉼표로 여러 개). Nginx로 같은 도메인에서 서빙하면 사실상 안 쓰인다.
CORS_ORIGINS=http://localhost:5173
