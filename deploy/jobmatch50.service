# /etc/systemd/system/jobmatch50.service
[Unit]
Description=jobmatch50 FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobmatch50/backend
ExecStart=/home/ubuntu/jobmatch50/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
